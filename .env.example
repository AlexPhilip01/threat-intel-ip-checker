# Copy this file to .env for local development and fill in real values.
# NEVER commit the real .env file — it's already covered by .gitignore.
# On Render, set these in the dashboard's Environment tab instead of a file.

# --- Threat intel API keys (set at least one — all three is best) ---
# Free key: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Free key: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# Free key: https://account.shodan.io/register
SHODAN_API_KEY=

# --- Email alerts (Gmail SMTP + an App Password) ---
# 1. Turn on 2-Step Verification on the Gmail account you want to send from.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (NOT your normal Gmail password).
GMAIL_ADDRESS=youralerts@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
ALERT_EMAIL_TO=where_to_send_alerts@example.com

# --- Scheduler ---
ENABLE_SCHEDULER=true
CHECK_INTERVAL_HOURS=2

# --- Flask ---
PORT=5000
FLASK_DEBUG=false
